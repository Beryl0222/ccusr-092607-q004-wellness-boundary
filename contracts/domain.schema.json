{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "疗愈服务合规边界案卷领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "OFFER_VERSIONED",
        "CLAIM_SCREENED",
        "CONSENT_RECORDED",
        "CONSENT_WITHDRAWN",
        "CASE_OPENED",
        "COMPLAINT_RECEIPTED",
        "COMPLAINT_SPLIT",
        "FUNDS_HELD",
        "REFUND_ISSUED",
        "DEPOSIT_DEDUCTED",
        "DEADLINE_PAUSED",
        "DEADLINE_RESUMED",
        "OBLIGATION_FULFILLED",
        "REMEDY_EXECUTED",
        "DISPOSITION_RECORDED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "service_provider",
        "wellness_offer",
        "marketing_claim",
        "consumer_case",
        "consent",
        "complaint",
        "payment"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "CLAIM_SCREENED": [
      "rule_version",
      "review_scope"
    ],
    "CASE_OPENED": [
      "contract_snapshot",
      "evidence_hashes"
    ],
    "CONSENT_WITHDRAWN": [
      "consent_ref"
    ],
    "COMPLAINT_RECEIPTED": [
      "complaint_no",
      "receipt_no",
      "fingerprint"
    ],
    "COMPLAINT_SPLIT": [
      "complaint_no",
      "receipt_no",
      "linked_to"
    ],
    "FUNDS_HELD": [
      "order_ref",
      "amount_cents",
      "idempotency_key"
    ],
    "REFUND_ISSUED": [
      "order_ref",
      "amount_cents",
      "idempotency_key"
    ],
    "DEPOSIT_DEDUCTED": [
      "obligor_ref",
      "amount_cents",
      "idempotency_key"
    ],
    "DEADLINE_PAUSED": [
      "case_ref",
      "deadline_kind"
    ],
    "DEADLINE_RESUMED": [
      "case_ref",
      "deadline_kind"
    ],
    "OBLIGATION_FULFILLED": [
      "obligation_ref",
      "obligor_ref"
    ],
    "REMEDY_EXECUTED": [
      "obligor_ref",
      "amount"
    ],
    "DISPOSITION_RECORDED": [
      "outcome",
      "rule_version",
      "evidence_hashes"
    ]
  },
  "additionalProperties": false
}
